{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auradash-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "auradash-storage",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mobidash",
			"database_id": "5517ff1c-990b-4dc0-8c69-83e1766fb678",
			"migrations_dir": "migrations"
		}
	],
	"send_email": [
		{
			"name": "EMAILER",
			"remote": true
		}
	],
	"vars": {
		"APP_FRONTEND_URL": "https://test-oura.ymzerotwo.com",
		"MOBIDASH_API_KEY": "mbd_sec_49a8f2190bc7e3d168a",
		"mobidash_MASTER_SECRET": "your_custom_master_crypto_secret_here",
		"CF_ACCOUNT_ID": "your_cloudflare_account_id_here",
		"CLOUDFLARE_API_TOKEN": "your_cloudflare_api_token_here",
		"EMAIL_FROM_ADDRESS": "noreply@yourdomain.com",
		"R2_PUBLIC_URL": "https://auradash-storage.ymzerotwo.com"
	},
	"kv_namespaces": [
		{
			"binding": "mobidash",
			"id": "389eb059f51d4d3aada66bbcd6bba2e7",
			"preview_id": "389eb059f51d4d3aada66bbcd6bba2e7",
			"remote": false
		}
	],
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},
		{
			"name": "DASHBOARD_LIMITER",
			"namespace_id": "1004",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "LOGIN_RECOVERY_LIMITER",
			"namespace_id": "1005",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "VERIFY_CODE_LIMITER",
			"namespace_id": "1006",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "STATE_LIMITER",
			"namespace_id": "1007",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "NOTIFICATIONS_LIMITER",
			"namespace_id": "1008",
			"simple": {
				"limit": 40,
				"period": 60
			}
		},
		{
			"name": "FILES_LIMITER",
			"namespace_id": "1010",
			"simple": {
				"limit": 200,
				"period": 60
			}
		},
		{
			"name": "HEALTH_LIMITER",
			"namespace_id": "1011",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
