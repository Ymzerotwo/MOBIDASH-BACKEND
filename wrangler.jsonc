{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auradash-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mobidash",
			"database_id": "ce2050d1-1e0f-4451-b6c9-69a1153c30db",
			"migrations_dir": "migrations"
		}
	],
	"send_email": [
		{
			"name": "EMAILER",
			"remote": true
		}
	],
	"vars": {
		"APP_FRONTEND_URL": "https://mobidash.ymzerotwo.com",
		"MOBIDASH_API_KEY": "mbd_sec_49a8f2190bc7e3d168a",
		"CF_ACCOUNT_ID": "453201237115cc94a6d2855b7089a701",
		"CLOUDFLARE_API_TOKEN": "your_cloudflare_api_token_here",
		"EMAIL_FROM_ADDRESS": "noreply@mobidash.ymzerotwo.com"
	},
	"kv_namespaces": [
		{
			"binding": "mobidash",
			"id": "53d8d9c68c814487a6d4333d83d076b7",
			"preview_id": "53d8d9c68c814487a6d4333d83d076b7",
			"remote": false
		}
	],
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},
		{
			"name": "DASHBOARD_LIMITER",
			"namespace_id": "1004",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "LOGIN_RECOVERY_LIMITER",
			"namespace_id": "1005",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "VERIFY_CODE_LIMITER",
			"namespace_id": "1006",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "STATE_LIMITER",
			"namespace_id": "1007",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "NOTIFICATIONS_LIMITER",
			"namespace_id": "1008",
			"simple": {
				"limit": 40,
				"period": 60
			}
		},
		{
			"name": "FILES_LIMITER",
			"namespace_id": "1010",
			"simple": {
				"limit": 200,
				"period": 60
			}
		},
		{
			"name": "HEALTH_LIMITER",
			"namespace_id": "1011",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
